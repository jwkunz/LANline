<?xml version="1.0" encoding="utf-8"?>
<!-- The LANline server is a plain-HTTP service on the local LAN. Allow cleartext
     everywhere (this app only ever talks to a user-entered / beacon-discovered
     LAN address). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
